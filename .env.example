# 复制为 .env 后填写。不填 LLM_* 时自动进入演示（mock）模式，流程照样能完整跑通。
PORT=3100
# 线上用 Postgres（如 Neon），本地不填则使用 data/atoms-demo.db（Node 内置 SQLite）
DATABASE_URL=
# 任意 OpenAI 兼容接口（DeepSeek / 通义 / OpenRouter / 自建网关）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
# 赛马可选模型，逗号分隔，前 3 个为默认赛马阵容
LLM_MODELS=model-a,model-b,model-c
# Mike（需求拆解）用的模型，建议选最快的
LLM_PLANNER_MODEL=model-a
# 设为 1 强制演示模式
MOCK_MODE=
# Google 登录（OAuth Web 客户端 ID，非机密）；不填则不显示 Google 登录按钮
GOOGLE_CLIENT_ID=
# 赛马：领先一路完成后其余路最多再等多少毫秒（默认 150000）
RACE_GRACE_MS=
